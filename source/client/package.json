{
  "name": "grammar-quest-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --plugin=prettier-plugin-java --ignore-path ../../.prettierignore --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{ts,json,html}\" \"../server/src/**/*.java\" \"../server/src/**/*.yml\"",
    "format:check": "prettier --plugin=prettier-plugin-java --ignore-path ../../.prettierignore --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{ts,json,html}\" \"../server/src/**/*.java\" \"../server/src/**/*.yml\""
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.14",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.1",
    "tailwindcss": "4.1.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
