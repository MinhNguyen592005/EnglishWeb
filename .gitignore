# Dependencies, build output and local test artifacts.
**/node_modules/
**/dist/
**/target/
**/artifacts/
**/*.tsbuildinfo
.npm-cache/
coverage/
**/coverage/
**/test-results/
**/playwright-report/

# Local configuration. Keep distributable example files.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Editor, OS and Python-generated files.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

# Logs, compiled classes and local backups.
*.log
*.class
/.local-backups/

# Temporary classroom recovery files and runtime uploads.
/source/client/classroom*-recovery.*
/source/server/downloads/
/source/server/statics/
